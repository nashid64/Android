<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg"
    >

    <!-- TOP BRAND BAR -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentTop="true"

        android:elevation="6dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <!-- BRAND NAME LEFT -->
        <TextView
            android:id="@+id/brandName"
            android:layout_width="152dp"
            android:layout_height="55dp"
            android:fontFamily="sans-serif-black"
            android:text="Fatashop"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0" />

        <!-- NOTIFICATION ICON RIGHT -->
        <ImageView
            android:id="@+id/notiIcon"
            android:layout_width="37dp"
            android:layout_height="36dp"
            android:padding="6dp"
            android:src="@drawable/outline_circle_notifications_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- BADGE COUNT -->
        <TextView
            android:id="@+id/notiCount"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/badge_bg"
            android:gravity="center"
            android:text="3"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            android:translationX="8dp"
            android:translationY="-4dp"
            app:layout_constraintEnd_toEndOf="@+id/notiIcon"
            app:layout_constraintTop_toTopOf="@+id/notiIcon" />

        <TextView
            android:id="@+id/textView7"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="136dp"
            android:layout_marginTop="36dp"
            android:fontFamily="sans-serif"
            android:text="Merchant"
            android:textAllCaps="true"
            android:textSize="12sp"
            android:textStyle="bold|italic"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- SCROLL CONTENT BELOW TOP BAR -->
    <ScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNav"
        android:layout_below="@id/topBar"
        android:fillViewport="true"
        android:padding="20dp">

        <LinearLayout
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- TOP 2x2 CARDS -->
            <LinearLayout
                android:id="@+id/topCardsHolder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="18dp"
                android:orientation="vertical">

                <!-- Row 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardPending"
                        android:layout_width="0dp"
                        android:layout_height="130dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#FFF5E6"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="5dp"
                        >

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="bottom"
                            android:orientation="vertical"
                            android:paddingStart="17dp"
                           >

                            <TextView
                                android:id="@+id/tvPendingTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pending Orders"
                                android:textColor="#000"
                                android:textSize="17sp"
                                 />

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardPackaging"
                        android:layout_width="0dp"
                        android:layout_height="130dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#FFF5E6"
                        app:cardCornerRadius="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="bottom"
                            android:orientation="vertical"
                            android:paddingStart="17dp"
                           >

                            <TextView
                                android:id="@+id/tvPackagingTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Packaging Orders"
                                android:textColor="#000"
                                android:textSize="17sp"
                                 />

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="131dp"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardConfirmed"
                        android:layout_width="0dp"
                        android:layout_height="130dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#FFF5E6"
                        app:cardCornerRadius="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="130dp"
                            android:gravity="bottom"
                            android:orientation="vertical"
                            android:paddingStart="17dp">

                            <TextView
                                android:id="@+id/tvConfirmedTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Confirmed Orders"
                                android:textColor="#000"
                                android:textSize="17sp"
                                 />

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardOutForDelivery"
                        android:layout_width="0dp"
                        android:layout_height="130dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="#FFF5E6"
                        app:cardCornerRadius="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="bottom"
                            android:orientation="vertical"
                            android:paddingStart="17dp">

                            <TextView
                                android:id="@+id/tvOutTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Out for Delivery"
                                android:textColor="#000"
                                android:textSize="17sp"
                              />

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </LinearLayout>

            <!-- EXTRA OPTIONS LIST WITH BADGES -->
            <LinearLayout
                android:id="@+id/extraOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp"

                android:elevation="3dp"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp">

                <!-- Delivered -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/optDelivered"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Delivered"
                        android:textColor="#FFF"
                        android:textSize="16sp"
                        android:gravity="center_vertical"/>

                    <TextView
                        android:id="@+id/deliveredCount"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:background="@drawable/badge_green"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="@android:color/white"
                        android:textSize="10sp"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"/>

                <!-- Canceled -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/optCanceled"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Canceled"
                        android:textColor="#FFF"
                        android:textSize="16sp"
                        android:gravity="center_vertical"/>

                    <TextView
                        android:id="@+id/canceledCount"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:background="@drawable/badge_bg"
                        android:gravity="center"
                        android:text="2"
                        android:textColor="@android:color/white"
                        android:textSize="10sp"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"/>

                <!-- Return -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/optReturn"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Return"
                        android:textColor="#FFF"
                        android:textSize="16sp"
                        android:gravity="center_vertical"/>

                    <TextView
                        android:id="@+id/returnCount"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:background="@drawable/badge_orange"
                        android:gravity="center"
                        android:text="1"
                        android:textColor="@android:color/white"
                        android:textSize="10sp"/>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E0E0E0"/>

                <!-- Failed -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/optFailed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Failed to Delivery"
                        android:textColor="#FFF"
                        android:textSize="16sp"
                        android:gravity="center_vertical"/>

                    <TextView
                        android:id="@+id/failedCount"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:background="@drawable/badge_gray"
                        android:gravity="center"
                        android:text="0"
                        android:textColor="@android:color/white"
                        android:textSize="10sp"/>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM NAV -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#33FFFFFF"
        android:elevation="10dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"

        >

        <TextView
            android:id="@+id/tabHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:drawableTop="@drawable/baseline_home_24"
            android:gravity="center_horizontal"
            android:text="Home"
            android:textColor="#000"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tabOrders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:drawableTop="@drawable/outline_format_list_bulleted_24"
            android:gravity="center_horizontal"
            android:text="My Orders"
            android:textColor="#000"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tabMenu"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:drawableTop="@drawable/outline_browse_24"
            android:gravity="center_horizontal"
            android:text="Menu"
            android:textColor="#000"
            android:textSize="13sp" />
    </LinearLayout>

</RelativeLayout>
