<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/popup_bg"
    android:padding="16dp"
    android:elevation="18dp">

    <!-- Notification Item 1 -->
    <TextView
        android:id="@+id/option_settings3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your “Winter Sale” campaign starts tomorrow."
        android:textSize="14sp"
        android:textColor="#000"
        android:padding="10dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"/>

    <!-- Notification Item 2 -->
    <TextView
        android:id="@+id/option_settings2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="New order received."
        android:textSize="14sp"
        android:textColor="#000"
        android:padding="10dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"/>

    <!-- Notification Item 3 -->
    <TextView
        android:id="@+id/option_profile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Delivery failed for order 451020."
        android:textSize="14sp"
        android:textColor="#000"
        android:padding="10dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"/>

    <!-- Notification Item 4 -->
    <TextView
        android:id="@+id/option_logout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Payment of 120 TAKA received for order 671015."
        android:textSize="14sp"
        android:textColor="#000"
        android:padding="10dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"/>

    <!-- Notification Item 5 -->
    <TextView
        android:id="@+id/option_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Customer requested a return for order 951017."
        android:textSize="14sp"
        android:textColor="#000"
        android:padding="10dp"/>
</LinearLayout>
