<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/fatashop"
    >

    <!-- Order Total Section -->
    <TextView
        android:id="@+id/tvOrderTotalLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Order Total:"
        android:textStyle="bold"
        android:textSize="14sp"
        android:layout_marginBottom="2dp"
        android:textColor="#FFF"/>

    <TextView
        android:id="@+id/tvOrderTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0.00 💰"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="#FFF"
        android:layout_marginBottom="6dp"/>

    <!-- LinearLayout for dynamically added products -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardOrderList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardCornerRadius="18dp"
        app:cardElevation="8dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="#F5F5F5"
        app:cardBackgroundColor="#F5F5F5"
        android:alpha="0.97">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"

            android:padding="4dp">

            <LinearLayout
                android:id="@+id/llOrderList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                />
        </ScrollView>
    </androidx.cardview.widget.CardView>

    <!-- Input Section -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        android:backgroundTint="#FFECB3">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- Photo Selector -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivProductPhoto"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/rounded_background"
                    android:contentDescription="Product photo"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_camera"/>

                <Button
                    android:id="@+id/btnChoosePhoto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#FFB74D"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="Add Photo"
                    android:textColor="#FFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Product Name -->
            <EditText
                android:id="@+id/etProductName"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:hint="Product name"
                android:textSize="14sp"
                android:background="@drawable/rounded_edittext"
                android:padding="6dp"
                android:inputType="textPersonName"/>

            <!-- Price -->
            <EditText
                android:id="@+id/etProductPrice"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="4dp"
                android:hint="Price"
                android:textSize="14sp"
                android:background="@drawable/rounded_edittext"
                android:padding="6dp"
                android:inputType="numberDecimal"/>

            <!-- Quantity -->
            <EditText
                android:id="@+id/etProductQuantity"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="4dp"
                android:hint="Quantity"
                android:textSize="14sp"
                android:background="@drawable/rounded_edittext"
                android:padding="6dp"
                android:inputType="number"/>

            <!-- Add Button -->
            <Button
                android:id="@+id/btnAddProduct"
                android:layout_width="match_parent"

                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#FF7043"

                android:text="Add Product!"
                android:textColor="#FFF"
                android:textSize="10sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
