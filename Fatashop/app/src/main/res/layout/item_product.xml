<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:padding="8dp">

    <ImageView
        android:id="@+id/productImageItem"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/ic_person_placehold"
        android:scaleType="centerCrop"
        android:background="@drawable/circle_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView
        android:id="@+id/productNameItem"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Product Name"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/productImageItem"
        app:layout_constraintTop_toTopOf="@id/productImageItem"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="12dp"/>

    <TextView
        android:id="@+id/productPriceItem"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="৳ 100"
        android:textSize="14sp"
        android:textColor="#6200EE"
        app:layout_constraintStart_toEndOf="@id/productImageItem"
        app:layout_constraintTop_toBottomOf="@id/productNameItem"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="12dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>
